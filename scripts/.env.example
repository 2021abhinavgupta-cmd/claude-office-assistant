# Copy to  scripts/.env  and fill in, then:  python scripts/laptop_agent.py --env-file ...
# (these scripts read plain env vars — on Windows use `set VAR=value`, or a .env
#  loader of your choice. .env is gitignored; this .example is the template.)

# Where Lumina is hosted
LUMINA_URL=https://lumina.mmga.agency

# Knowledge sync (kb_sync.py / laptop_agent job 1) — must match Railway
STORAGE_SYNC_TOKEN=

# DB backup (laptop_agent job 3) — Railway's FLASK_SECRET_KEY
FLASK_SECRET_KEY=

# Health alerts (laptop_agent job 4). Comma-separated apprise URLs, e.g.
#   tgram://<bot-token>/<chat-id>       (Telegram)
#   discord://<webhook_id>/<webhook_token>
#   mailto://user:pass@gmail.com
#   ntfy://ntfy.sh/lumina-alerts
ALERT_TARGETS=
# Fallback if ALERT_TARGETS is empty: a single Slack/Discord-style JSON webhook
ALERT_WEBHOOK=
