# Copy this file to .env in the same directory and fill in real values.
# docker compose reads .env automatically.

GLITCHTIP_DB_PASSWORD=change-me-to-something-random
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
GLITCHTIP_SECRET_KEY=change-me-too
# Include the scheme. If this runs on the always-on laptop on your LAN:
# http://<laptop-lan-ip>:8000  (Lumina on Railway needs outbound HTTPS to
# reach it though -- see README.md for the "how does Railway reach my
# laptop" note before assuming a bare LAN address works).
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_PORT=8000
GLITCHTIP_FROM_EMAIL=glitchtip@localhost
