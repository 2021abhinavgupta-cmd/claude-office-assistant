# Copy to  .env  and fill in, then run:  node --env-file=.env index.js
# (.env is gitignored; .env.example is the template)

# Where Lumina is hosted
LUMINA_URL=https://lumina.mmga.agency

# Shared secret — MUST match the value set on Railway.
# If you didn't set WHATSAPP_BRIDGE_TOKEN on Railway, use its FLASK_SECRET_KEY here.
WHATSAPP_BRIDGE_TOKEN=

# Where the WhatsApp pairing/session is stored (default ./auth). Delete this
# folder to unpair / switch to a different number.
AUTH_DIR=./auth
